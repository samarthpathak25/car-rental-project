API Endpoint Example (Express.js)
javascript
Copy code
// Add a car
app.post('/api/admin/addCar', (req, res) => {
    const { name, model, price, description, image, availability } = req.body;
    Car.create({ name, model, price, description, image, availability })
        .then(car => res.status(201).send(car))
        .catch(err => res.status(500).send(err));
});

// Approve booking
app.post('/api/admin/approveBooking', (req, res) => {
    const { bookingId, startDate, endDate } = req.body;
    Booking.findByIdAndUpdate(bookingId, { status: 'Approved', startDate, endDate })
        .then(() => res.status(200).send('Booking Approved'))
        .catch(err => res.status(500).send(err));
});
Frontend Example (React.js)
jsx
Copy code
import React, { useState, useEffect } from 'react';

function CarList() {
    const [cars, setCars] = useState([]);

    useEffect(() => {
        fetch('/api/cars')
            .then(response => response.json())
            .then(data => setCars(data));
    }, []);

    return (
        <div className="container">
            <h1>Available Cars</h1>
            <div className="row">
                {cars.map(car => (
                    <div className="col-md-4" key={car.id}>
                        <div className="card">
                            <img src={car.image} className="card-img-top" alt={car.name} />
                            <div className="card-body">
                                <h5 className="card-title">{car.name}</h5>
                                <p className="card-text">{car.description}</p>
                                <button className="btn btn-primary">Book Now</button>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    );
}






